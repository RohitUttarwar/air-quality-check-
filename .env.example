# AWS Configuration
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# DynamoDB Tables
DYNAMODB_SCHOOLS_TABLE=AirDuty_Schools
DYNAMODB_DECISIONS_TABLE=AirDuty_Decisions

# Alerts (SNS Topic ARN)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:AirDuty_Alerts
ALERT_EMAIL=principal@school.edu

# Air Quality Data Providers
# Optional: WAQI station token (aqicn.org). If unset, system falls back smoothly to Open-Meteo.
WAQI_TOKEN=

# Default School Configuration
DEFAULT_SCHOOL_ID=delhi-model-school-01
DEFAULT_SCHOOL_NAME=Delhi Model School
DEFAULT_SCHOOL_LAT=28.6139
DEFAULT_SCHOOL_LON=77.2090
DEFAULT_GRADE_RANGE=K-12
DEFAULT_SENSITIVE_STUDENTS=45

# Local Server Port
PORT=8000
